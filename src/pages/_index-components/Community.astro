---
import SolidButton from '../../components/actions/buttons/SolidButton.astro';
import SectionHeading from '../../components/typography/SectionHeading.astro';
import { textClasses } from '../../components/typography/textStyles.ts';
import {
  GITHUB_REPO_URL,
  MASTODON_URL,
  MATRIX_ROOM_URL,
} from '../../lib/community';

const linkClasses = 'text-purple-500 hover:text-purple-600';
---

<div id="community" class="flex flex-col items-center gap-8">
  <div class="flex flex-col items-center gap-4">
    <SectionHeading text="Join the Community" classes="text-center" />
    <p class={`text-center ${textClasses}`}>
      Talk with the team and other writers, report bugs, and help shape what v2
      becomes.
    </p>
  </div>
  <div class="flex flex-col items-center gap-3 w-full sm:w-auto">
    <a
      href={MATRIX_ROOM_URL}
      target="_blank"
      rel="noopener"
      class="w-full sm:w-auto"
    >
      <SolidButton
        icon="fa-matrix"
        text="Join us on Matrix"
        size="lg"
        classes="w-full sm:w-auto"
      />
    </a>
    <p class="text-sm text-center">
      You can also follow v2 on
      <a href={MASTODON_URL} target="_blank" rel="noopener" class={linkClasses}>
        Mastodon
      </a>
      and
      <a
        href={GITHUB_REPO_URL}
        target="_blank"
        rel="noopener"
        class={linkClasses}
      >
        GitHub
      </a>
    </p>
  </div>
</div>
